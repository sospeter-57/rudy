# Base path for the Go API (proxied by Vite in development)
VITE_API_BASE=/api

# Vite dev server port and the Go API origin it proxies /api to. The API origin
# belongs here rather than in vite.config.ts; keep the backend's
# RUDY_CORS_ORIGINS in sync if you call the API without the proxy.
VITE_DEV_PORT=5173
VITE_PROXY_TARGET=http://localhost:8080

# Google sign-in: same OAuth 2.0 "Web application" client ID as
# RUDY_GOOGLE_CLIENT_ID in back/.env. Leave empty to hide the Google button.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
