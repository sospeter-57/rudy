# Copy to back/.env; the server loads it automatically at startup.
# Variables already present in the process environment take precedence.

# HTTP bind IP and port. Set both independently, or use RUDY_ADDR as a full
# override (for example RUDY_ADDR=127.0.0.1:9000) or a bare port (RUDY_ADDR=9000).
# RUDY_PORT wins over the platform-standard PORT injected by hosts like Render,
# Railway, Heroku and Fly.
RUDY_HOST=0.0.0.0
RUDY_PORT=8080
# RUDY_ADDR=127.0.0.1:8080
# PORT=8080

# SQLite database file
RUDY_DB=rudy.db

# Directory for chat image attachments. Mount a persistent volume here in
# production so uploads survive restarts.
RUDY_UPLOAD_DIR=uploads

# Browser origins allowed to call this API from another origin, as a
# comma-separated list (for example https://rudy.example.com). Leave empty when
# the client is served from the same origin or through the Vite proxy. Use "*"
# to allow any origin (not recommended for deployments that handle private data).
RUDY_CORS_ORIGINS=http://localhost:5173

# Session lifetime in hours (720 = 30 days)
RUDY_SESSION_TTL_HOURS=720

# Google sign-in: OAuth 2.0 "Web application" client ID from Google Cloud
# Console. The frontend must use the same value as VITE_GOOGLE_CLIENT_ID.
# Authorize your app origins (for local development: http://localhost:5173).
# RUDY_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Optional: load a different env file (default: .env in the working directory)
# RUDY_ENV_FILE=.env
