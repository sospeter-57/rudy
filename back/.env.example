# Copy to back/.env; the server loads it automatically at startup.
# Variables already present in the process environment take precedence.

# HTTP bind IP and port. Set both independently, or use RUDY_ADDR as a full
# override (for example RUDY_ADDR=127.0.0.1:9000) or a bare port (RUDY_ADDR=9000).
# RUDY_PORT wins over the platform-standard PORT injected by hosts like Render,
# Railway, Heroku and Fly.
RUDY_HOST=0.0.0.0
RUDY_PORT=8080
# RUDY_ADDR=127.0.0.1:8080
# PORT=8080

# SQLite database file
RUDY_DB=rudy.db

# Session lifetime in hours (720 = 30 days)
RUDY_SESSION_TTL_HOURS=720

# Optional: load a different env file (default: .env in the working directory)
# RUDY_ENV_FILE=.env
